{
  "name": "stream-json-repair",
  "version": "1.0.0",
  "description": "Ultra-fast, zero-dependency streaming JSON parser & repair engine for LLM token streams (OpenAI, Gemini, Claude, Ollama) that auto-completes incomplete JSON in real-time.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:native": "node --test tests/*.test.js",
    "test:coverage": "vitest run --coverage",
    "bench": "node bench/benchmark.js",
    "example": "node examples/basic-usage.js",
    "example:stream": "node examples/openai-stream.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "json",
    "stream",
    "repair",
    "partial-json",
    "llm",
    "ai",
    "openai",
    "gemini",
    "claude",
    "ollama",
    "parser",
    "streaming-json",
    "zero-dependency",
    "transform-stream",
    "javascript",
    "nodejs"
  ],
  "author": "Ekansh Khatri <ekanshkhatri@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ekanshkhatri/stream-json-repair.git"
  },
  "bugs": {
    "url": "https://github.com/ekanshkhatri/stream-json-repair/issues"
  },
  "homepage": "https://github.com/ekanshkhatri/stream-json-repair#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.7",
    "vitest": "^3.0.7"
  }
}
